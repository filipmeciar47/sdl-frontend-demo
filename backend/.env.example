GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MAX_TOKENS=4096
DAILY_LIMIT=200

# CORS allowlist (ciarkou oddelene originy) — POVINNE.
# Bez tejto premennej endpoint vracia 503 a appka nefunguje. Nastav ju vo Vercel
# projekte `sdl-demo-backend` (Settings -> Environment Variables) SKOR, nez deploynes kod.
# Uvadzaj plny origin vratane https:// a bez lomitka na konci.
# Preview deploye frontendu pridaj sem tiez — zamerne na ne nie je regex, lebo
# vzor `sdl-demo-frontend-*.vercel.app` by pustil cudzi Vercel projekt s takym nazvom.
ALLOWED_ORIGINS=https://moj-demo-frontend.vercel.app
# lokalny dev: ALLOWED_ORIGINS=http://localhost:5173
